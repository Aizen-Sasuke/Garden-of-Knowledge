<%@page import="java.io.File" %>
<%@page import="java.sql.*" %>
<%
    Class.forName("org.h2.Driver");

    String dbLocation = application.getRealPath("/WEB-INF/data/projecticchi");
    if (dbLocation == null) {
        dbLocation = System.getProperty("user.home") + "/ProjectIcchi-data/projecticchi";
    }

    File dbFile = new File(dbLocation);
    File parentDir = dbFile.getParentFile();
    if (parentDir != null && !parentDir.exists()) {
        parentDir.mkdirs();
    }

    String url = "jdbc:h2:file:" + dbFile.getAbsolutePath().replace("\\", "/") + ";MODE=Oracle;DATABASE_TO_UPPER=false;AUTO_SERVER=TRUE";
    Connection conn = DriverManager.getConnection(url, "sa", "");

    if (application.getAttribute("dbInitialized") == null) {
        synchronized (application) {
            if (application.getAttribute("dbInitialized") == null) {
                Statement init = conn.createStatement();
                init.execute("CREATE TABLE IF NOT EXISTS users (" +
                    "id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
                    "username VARCHAR(100) NOT NULL UNIQUE, " +
                    "password VARCHAR(100) NOT NULL, " +
                    "role VARCHAR(20) NOT NULL)");
                init.execute("CREATE TABLE IF NOT EXISTS books (" +
                    "id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
                    "title VARCHAR(255) NOT NULL, " +
                    "author VARCHAR(255) NOT NULL, " +
                    "genre VARCHAR(100), " +
                    "total_copies INT NOT NULL, " +
                    "available_copies INT NOT NULL)");
                init.execute("CREATE TABLE IF NOT EXISTS members (" +
                    "id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
                    "name VARCHAR(255) NOT NULL, " +
                    "email VARCHAR(255), " +
                    "phone VARCHAR(50))");
                init.execute("CREATE TABLE IF NOT EXISTS borrowings (" +
                    "id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
                    "book_id INT NOT NULL, " +
                    "member_id INT NOT NULL, " +
                    "borrow_date DATE NOT NULL, " +
                    "return_date DATE, " +
                    "CONSTRAINT fk_borrow_book FOREIGN KEY (book_id) REFERENCES books(id) ON DELETE CASCADE, " +
                    "CONSTRAINT fk_borrow_user FOREIGN KEY (member_id) REFERENCES users(id) ON DELETE CASCADE)");

                ResultSet userCount = init.executeQuery("SELECT COUNT(*) FROM users");
                userCount.next();
                if (userCount.getInt(1) == 0) {
                    PreparedStatement seedUsers = conn.prepareStatement(
                        "INSERT INTO users (username, password, role) VALUES (?, ?, ?)");
                    seedUsers.setString(1, "admin");
                    seedUsers.setString(2, "admin123");
                    seedUsers.setString(3, "admin");
                    seedUsers.executeUpdate();
                    seedUsers.setString(1, "user");
                    seedUsers.setString(2, "user123");
                    seedUsers.setString(3, "user");
                    seedUsers.executeUpdate();
                }

                ResultSet bookCount = init.executeQuery("SELECT COUNT(*) FROM books");
                bookCount.next();
                if (bookCount.getInt(1) == 0) {
                    PreparedStatement seedBooks = conn.prepareStatement(
                        "INSERT INTO books (title, author, genre, total_copies, available_copies) VALUES (?, ?, ?, ?, ?)");
                    seedBooks.setString(1, "The Hidden Library");
                    seedBooks.setString(2, "A. Reader");
                    seedBooks.setString(3, "Fantasy");
                    seedBooks.setInt(4, 3);
                    seedBooks.setInt(5, 3);
                    seedBooks.executeUpdate();

                    seedBooks.setString(1, "Quiet Code");
                    seedBooks.setString(2, "M. Builder");
                    seedBooks.setString(3, "Technology");
                    seedBooks.setInt(4, 2);
                    seedBooks.setInt(5, 2);
                    seedBooks.executeUpdate();

                    seedBooks.setString(1, "Stories of Light");
                    seedBooks.setString(2, "N. Bloom");
                    seedBooks.setString(3, "Literature");
                    seedBooks.setInt(4, 4);
                    seedBooks.setInt(5, 4);
                    seedBooks.executeUpdate();
                }

                ResultSet memberCount = init.executeQuery("SELECT COUNT(*) FROM members");
                memberCount.next();
                if (memberCount.getInt(1) == 0) {
                    PreparedStatement seedMembers = conn.prepareStatement(
                        "INSERT INTO members (name, email, phone) VALUES (?, ?, ?)");
                    seedMembers.setString(1, "Alice Reader");
                    seedMembers.setString(2, "alice@example.com");
                    seedMembers.setString(3, "555-0101");
                    seedMembers.executeUpdate();

                    seedMembers.setString(1, "Ben Scholar");
                    seedMembers.setString(2, "ben@example.com");
                    seedMembers.setString(3, "555-0102");
                    seedMembers.executeUpdate();
                }

                application.setAttribute("dbInitialized", Boolean.TRUE);
            }
        }
    }
%>